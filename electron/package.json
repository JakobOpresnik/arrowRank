{
  "name": "arrow-rank",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "electron": "^38.7.2",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.arrowrank.desktop",
    "productName": "ArrowRank",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend"
      },
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "desktop_icon.ico",
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    },
    "asar": false
  }
}
